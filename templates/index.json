        "remove_vertical_spacing": true,
        "remove_horizontal_spacing": true,
        "liquid": "{% liquid\n  assign qlf_jour = 'Vendredi'\n  assign qlf_heure = '20H'\n  assign qlf_titre_ligne_1 = 'Bracelet Que La Famille'\n  assign qlf_titre_ligne_2 = 'DE RETOUR À 20H !'\n  assign qlf_description = 'Ne manque pas le drop. Inscris-toi !'\n  assign qlf_bouton = 'M’avertir du drop'\n  assign qlf_tags = 'newsletter,drop-bracelet-qlf'\n  assign qlf_id = 'qlf-drop-' | append: section.id | append: '-' | append: block.id\n  assign qlf_form_id = qlf_id | append: '-form'\n%}\n\n<style>\n  #{{ qlf_id }} {\n    --qlf-fond: #101010;\n    --qlf-texte: #ffffff;\n    --qlf-secondaire: #b5b5b5;\n    --qlf-ligne: #383838;\n    width: calc(100% - 32px);\n    max-width: 1180px;\n    margin: 28px auto;\n    color: var(--qlf-texte);\n    font-family: inherit;\n    text-align: left;\n    -webkit-font-smoothing: antialiased;\n  }\n\n  #{{ qlf_id }},\n  #{{ qlf_id }} * {\n    box-sizing: border-box;\n  }\n\n  #{{ qlf_id }} p,\n  #{{ qlf_id }} h2 {\n    margin: 0;\n  }\n\n  #{{ qlf_id }} .qlf-drop__card {\n    display: grid;\n    grid-template-columns: minmax(0, 1.7fr) minmax(180px, 0.8fr);\n    grid-template-areas:\n      \"intro moment\"\n      \"signup moment\";\n    gap: 28px 52px;\n    padding: clamp(24px, 5vw, 60px);\n    background: var(--qlf-fond);\n    border: 1px solid var(--qlf-ligne);\n    border-radius: 22px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__intro {\n    grid-area: intro;\n    min-width: 0;\n  }\n\n  #{{ qlf_id }} .qlf-drop__kicker {\n    display: flex;\n    align-items: center;\n    gap: 10px;\n    margin-bottom: 20px;\n    color: var(--qlf-secondaire);\n    font-size: 11px;\n    font-weight: 700;\n    line-height: 1.5;\n    letter-spacing: 0.18em;\n  }\n\n  #{{ qlf_id }} .qlf-drop__dot {\n    width: 7px;\n    height: 7px;\n    flex-shrink: 0;\n    border-radius: 50%;\n    background: var(--qlf-texte);\n  }\n\n  /* TITRE PLUS PETIT */\n  #{{ qlf_id }} .qlf-drop__title {\n    color: #ffffff;\n    font-family: inherit;\n    font-size: clamp(24px, 3vw, 38px);\n    font-weight: 800;\n    line-height: 1.2;\n    letter-spacing: -0.025em;\n    text-transform: none;\n    overflow-wrap: anywhere;\n  }\n\n  #{{ qlf_id }} .qlf-drop__title span {\n    display: block;\n  }\n\n  #{{ qlf_id }} .qlf-drop__title span + span {\n    margin-top: 8px;\n    font-size: 0.76em;\n    font-weight: 700;\n    letter-spacing: 0.01em;\n  }\n\n  #{{ qlf_id }} .qlf-drop__description {\n    max-width: 360px;\n    margin-top: 12px;\n    color: var(--qlf-secondaire);\n    font-size: 12px;\n    line-height: 1.5;\n  }\n\n  /* BLOC DATE ET HEURE */\n  #{{ qlf_id }} .qlf-drop__moment {\n    grid-area: moment;\n    display: flex;\n    flex-direction: column;\n    align-items: center;\n    justify-content: center;\n    gap: 20px;\n    min-width: 0;\n    padding-left: 40px;\n    border-left: 1px solid var(--qlf-ligne);\n    text-align: center;\n  }\n\n  #{{ qlf_id }} .qlf-drop__date {\n    display: grid;\n    gap: 12px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__badge {\n    color: var(--qlf-secondaire);\n    font-size: 10px;\n    font-weight: 700;\n    letter-spacing: 0.16em;\n    line-height: 1.5;\n  }\n\n  #{{ qlf_id }} .qlf-drop__day {\n    color: var(--qlf-texte);\n    font-size: 16px;\n    font-weight: 600;\n    line-height: 1.4;\n  }\n\n  #{{ qlf_id }} .qlf-drop__hour {\n    color: var(--qlf-texte);\n    font-family: inherit;\n    font-size: clamp(62px, 8vw, 108px);\n    font-weight: 800;\n    line-height: 1;\n    letter-spacing: -0.075em;\n    white-space: nowrap;\n  }\n\n  #{{ qlf_id }} .qlf-drop__zone {\n    color: var(--qlf-secondaire);\n    font-size: 12px;\n    line-height: 1.4;\n    letter-spacing: 0.08em;\n  }\n\n  /* FORMULAIRE NEWSLETTER */\n  #{{ qlf_id }} .qlf-drop__signup {\n    grid-area: signup;\n    min-width: 0;\n  }\n\n  #{{ qlf_id }} .qlf-drop__form {\n    margin: 0;\n    scroll-margin-top: 120px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__label {\n    display: block;\n    margin-bottom: 10px;\n    color: var(--qlf-texte);\n    font-size: 12px;\n    font-weight: 600;\n    line-height: 1.5;\n  }\n\n  #{{ qlf_id }} .qlf-drop__fields {\n    display: flex;\n    flex-wrap: wrap;\n    gap: 10px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__input {\n    flex: 1 1 190px;\n    width: 100%;\n    min-width: 0;\n    min-height: 56px;\n    padding: 15px 18px;\n    border: 1px solid #696969;\n    border-radius: 8px;\n    background: #1c1c1c;\n    color: var(--qlf-texte);\n    font: inherit;\n    font-size: 13px;\n    line-height: 1.4;\n    box-shadow: none;\n    appearance: none;\n  }\n\n  #{{ qlf_id }} .qlf-drop__input::placeholder {\n    color: #ababab;\n    opacity: 1;\n  }\n\n  #{{ qlf_id }} .qlf-drop__button {\n    display: inline-flex;\n    align-items: center;\n    justify-content: center;\n    gap: 12px;\n    flex: 1 1 180px;\n    min-height: 56px;\n    padding: 15px 20px;\n    border: 1px solid #ffffff;\n    border-radius: 8px;\n    background: #ffffff;\n    color: #101010;\n    font: inherit;\n    font-size: 13px;\n    font-weight: 700;\n    line-height: 1.4;\n    cursor: pointer;\n    appearance: none;\n    box-shadow: none;\n    transition: background 0.2s ease, transform 0.2s ease;\n  }\n\n  #{{ qlf_id }} .qlf-drop__button:hover {\n    background: #dfdfdf;\n    border-color: #dfdfdf;\n    transform: translateY(-2px);\n  }\n\n  #{{ qlf_id }} .qlf-drop__button svg {\n    width: 18px;\n    height: 18px;\n    flex-shrink: 0;\n  }\n\n  #{{ qlf_id }} .qlf-drop__input:focus-visible,\n  #{{ qlf_id }} .qlf-drop__button:focus-visible,\n  #{{ qlf_id }} a:focus-visible {\n    outline: 2px solid #ffffff;\n    outline-offset: 4px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__consent {\n    margin-top: 14px;\n    color: var(--qlf-secondaire);\n    font-size: 11px;\n    line-height: 1.7;\n  }\n\n  #{{ qlf_id }} .qlf-drop__consent a {\n    color: inherit;\n    text-decoration: underline;\n    text-underline-offset: 3px;\n  }\n\n  /* MESSAGES SHOPIFY */\n  #{{ qlf_id }} .qlf-drop__message {\n    padding: 18px;\n    border-radius: 8px;\n    font-size: 14px;\n    line-height: 1.6;\n  }\n\n  #{{ qlf_id }} .qlf-drop__success {\n    color: #d7f5df;\n    background: #182b1e;\n    border: 1px solid #426f50;\n  }\n\n  #{{ qlf_id }} .qlf-drop__success strong {\n    display: block;\n    margin-bottom: 5px;\n    color: inherit;\n  }\n\n  #{{ qlf_id }} .qlf-drop__error {\n    margin-bottom: 16px;\n    color: #ffd6d6;\n    background: #321c1c;\n    border: 1px solid #8c5050;\n  }\n\n  #{{ qlf_id }} .qlf-drop__error ul {\n    margin: 0;\n    padding-left: 18px;\n  }\n\n  #{{ qlf_id }} .qlf-drop__error a {\n    color: inherit;\n    text-decoration: underline;\n  }\n\n  /* RESPONSIVE MOBILE */\n  @media (max-width: 749px) {\n\n    #{{ qlf_id }} {\n      margin: 20px auto;\n    }\n\n    #{{ qlf_id }} .qlf-drop__card {\n      grid-template-columns: minmax(0, 1fr);\n      grid-template-areas:\n        \"intro\"\n        \"moment\"\n        \"signup\";\n      gap: 24px;\n      border-radius: 18px;\n    }\n\n    #{{ qlf_id }} .qlf-drop__title {\n      font-size: 25px;\n      line-height: 1.25;\n      letter-spacing: -0.025em;\n    }\n\n    #{{ qlf_id }} .qlf-drop__title span + span {\n      margin-top: 8px;\n      font-size: 0.8em;\n    }\n\n    #{{ qlf_id }} .qlf-drop__kicker {\n      margin-bottom: 18px;\n    }\n\n    #{{ qlf_id }} .qlf-drop__description {\n      margin-top: 10px;\n      font-size: 12px;\n    }\n\n    #{{ qlf_id }} .qlf-drop__moment {\n      display: grid;\n      grid-template-columns: minmax(0, 1fr) auto;\n      gap: 8px 20px;\n      padding: 20px 0;\n      border-left: 0;\n      border-top: 1px solid var(--qlf-ligne);\n      border-bottom: 1px solid var(--qlf-ligne);\n      text-align: left;\n    }\n\n    #{{ qlf_id }} .qlf-drop__date {\n      gap: 7px;\n    }\n\n    #{{ qlf_id }} .qlf-drop__hour {\n      grid-column: 2;\n      grid-row: 1 / 3;\n      font-size: clamp(52px, 16vw, 80px);\n    }\n\n    #{{ qlf_id }} .qlf-drop__zone {\n      grid-column: 1;\n      grid-row: 2;\n      font-size: 10px;\n    }\n  }\n\n  @media (max-width: 479px) {\n\n    #{{ qlf_id }} .qlf-drop__fields {\n      flex-direction: column;\n    }\n\n    #{{ qlf_id }} .qlf-drop__input,\n    #{{ qlf_id }} .qlf-drop__button {\n      flex: none;\n      width: 100%;\n    }\n  }\n\n  @media (prefers-reduced-motion: reduce) {\n    #{{ qlf_id }} .qlf-drop__button {\n      transition: none;\n    }\n\n    #{{ qlf_id }} .qlf-drop__button:hover {\n      transform: none;\n    }\n  }\n</style>\n\n<section\n  id=\"{{ qlf_id }}\"\n  aria-labelledby=\"{{ qlf_id }}-title\"\n>\n  <div class=\"qlf-drop__card\">\n\n    <!-- INTRODUCTION -->\n    <div class=\"qlf-drop__intro\">\n\n\n      <h2\n        id=\"{{ qlf_id }}-title\"\n        class=\"qlf-drop__title\"\n      >\n        <span>{{ qlf_titre_ligne_1 | escape }}</span>\n        <span>{{ qlf_titre_ligne_2 | escape }}</span>\n      </h2>\n\n      <p class=\"qlf-drop__description\">\n        {{ qlf_description | escape }}\n      </p>\n\n    </div>\n\n    <!-- DATE DU DROP -->\n    <div class=\"qlf-drop__moment\">\n\n      <div class=\"qlf-drop__date\">\n        <p class=\"qlf-drop__badge\">\n          DROP BRACELET\n        </p>\n\n        <p class=\"qlf-drop__day\">\n          {{ qlf_jour | escape }}\n        </p>\n      </div>\n\n      <p class=\"qlf-drop__hour\">\n        {{ qlf_heure | escape }}\n      </p>\n\n      <p class=\"qlf-drop__zone\">\n        Heure de Paris\n      </p>\n\n    </div>\n\n    <!-- NEWSLETTER SHOPIFY -->\n    <div class=\"qlf-drop__signup\">\n\n      {% form 'customer', id: qlf_form_id, class: 'qlf-drop__form' %}\n\n        <input\n          type=\"hidden\"\n          name=\"contact[tags]\"\n          value=\"{{ qlf_tags | escape }}\"\n        >\n\n        {% if form.posted_successfully? %}\n\n          <div\n            class=\"qlf-drop__message qlf-drop__success\"\n            role=\"status\"\n          >\n            <strong>\n              Inscription reçue !\n            </strong>\n            Merci ! Si tu reçois un e-mail de confirmation,\n            clique sur le lien pour valider ton inscription.\n          </div>\n\n        {% else %}\n\n          {% if form.errors %}\n            <div\n              id=\"{{ qlf_id }}-error\"\n              class=\"qlf-drop__message qlf-drop__error\"\n              role=\"alert\"\n            >\n              {{ form.errors | default_errors }}\n            </div>\n          {% endif %}\n\n          <label\n            class=\"qlf-drop__label\"\n            for=\"{{ qlf_id }}-email\"\n          >\n            Ton adresse e-mail\n          </label>\n\n          <div class=\"qlf-drop__fields\">\n\n            <input\n              id=\"{{ qlf_id }}-email\"\n              class=\"qlf-drop__input\"\n              type=\"email\"\n              name=\"contact[email]\"\n              value=\"{{ form.email | escape }}\"\n              placeholder=\"toi@exemple.fr\"\n              autocomplete=\"email\"\n              autocorrect=\"off\"\n              autocapitalize=\"off\"\n              spellcheck=\"false\"\n              required\n              aria-describedby=\"{{ qlf_id }}-consent{% if form.errors %} {{ qlf_id }}-error{% endif %}\"\n              {% if form.errors %}\n                aria-invalid=\"true\"\n              {% endif %}\n            >\n\n            <button\n              type=\"submit\"\n              class=\"qlf-drop__button\"\n            >\n              {{ qlf_bouton | escape }}\n\n              <svg\n                viewBox=\"0 0 24 24\"\n                fill=\"none\"\n                aria-hidden=\"true\"\n                focusable=\"false\"\n              >\n                <path\n                  d=\"M5 12h14m-6-6 6 6-6 6\"\n                  stroke=\"currentColor\"\n                  stroke-width=\"1.8\"\n                  stroke-linecap=\"round\"\n                  stroke-linejoin=\"round\"\n                />\n              </svg>\n\n            </button>\n\n          </div>\n\n          <p\n            id=\"{{ qlf_id }}-consent\"\n            class=\"qlf-drop__consent\"\n          >\n            En t’inscrivant, tu acceptes de recevoir\n            les e-mails QLFWOOD. Désinscription à tout moment.\n\n            {% if shop.privacy_policy.url != blank %}\n              <a href=\"{{ shop.privacy_policy.url | escape }}\">\n                Confidentialité\n              </a>.\n            {% endif %}\n          </p>\n\n        {% endif %}\n\n      {% endform %}\n\n    </div>\n\n  </div>\n</section>",
